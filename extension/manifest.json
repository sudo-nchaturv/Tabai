{
  "manifest_version": 3,
  "name": "AI Tab Summarizer",
  "version": "1.0",
  "description": "Summarize webpages and multiple browser tabs using Google Gemini API.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Tab Summarizer"
  },
  "background": {
    "service_worker": "background.js"
  }
}
